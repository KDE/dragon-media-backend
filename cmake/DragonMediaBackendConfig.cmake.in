@PACKAGE_INIT@

include(FeatureSummary)
set_package_properties(DragonMediaBackend PROPERTIES
    DESCRIPTION "KDE audio library using SDL3, ffmpeg, kissfft, and C++23"
    URL "https://invent.kde.org/ianmonroe/dragon-media-backend")

include(CMakeFindDependencyMacro)

# Find required dependencies
find_dependency(Qt6 CONFIG COMPONENTS Core Network Gui REQUIRED)
find_dependency(QCoro6 CONFIG COMPONENTS Core REQUIRED)
find_dependency(SDL3 CONFIG REQUIRED)
find_dependency(KF6I18n CONFIG REQUIRED)

# Set up FFmpeg via pkg_check_modules.
find_dependency(PkgConfig REQUIRED)

pkg_check_modules(FFmpeg IMPORTED_TARGET REQUIRED
    libavformat
    libavcodec
    libswresample
    libavutil
)

# Include the targets file
include("${CMAKE_CURRENT_LIST_DIR}/DragonMediaBackend-targets.cmake")

check_required_components(DragonMediaBackend)
