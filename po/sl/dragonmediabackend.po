#: stream/cd/dragoncddisc.cpp:111
#, kde-format
msgid "The CD has no tracks."
msgstr "CD nima skladb."

#: stream/cd/dragoncddisc.cpp:148
#, kde-format
msgid "The disc is not an Audio CD."
msgstr "Plošča ni zvočni CD."

#: stream/cd/dragoncddisc.cpp:189
#, kde-format
msgid "Could not open the CD device. Check that a disc is present."
msgstr ""
"Naprave za CD ni bilo mogoče odpreti. Preverite, ali je vstavljena plošča."

#: stream/cd/dragoncdstream.cpp:117
#, kde-format
msgid "The audiocd:/ URL does not name a track to play."
msgstr "Naslov URL audiocd:/ ne določa skladbe za predvajanje."

#: stream/cd/dragoncdstream.cpp:155
#, kde-format
msgid "Track not found on the CD: %1"
msgstr "Skladba na CD-ju ni bila najdena: %1"

#: stream/cd/dragoncdstream.cpp:159
#, kde-format
msgid "CD track %1 is not an audio track."
msgstr "Skladba %1 na CD-ju ni zvočna skladba."

#: stream/cd/dragoncdstream.cpp:166
#, kde-format
msgid "Could not determine the length of CD track %1."
msgstr "Ni bilo mogoče določiti dolžine skladbe %1 na CD-ju."

#: stream/cd/dragoncdstream.cpp:284
#, kde-format
msgid "The CD is no longer available."
msgstr "CD ni več na voljo."

#: stream/cd/dragoncdstream.cpp:289
#, kde-format
msgid "Attempted to read past the end of the CD track."
msgstr "Poskus branja prek konca skladbe na CD-ju."

#: stream/cd/dragoncdstream.cpp:297
#, kde-format
msgid "Error reading the CD. The disc may have been ejected."
msgstr "Napaka pri branju CD-ja. Plošča je bila morda izvržena."

#: stream/cd/dragoncdtocreader.cpp:61
#, kde-format
msgid "This build of Dragon Media Backend was made without CD support."
msgstr ""
"Ta različica programa Dragon Media Backend je bila izdelana brez podpore za "
"CD-je."

