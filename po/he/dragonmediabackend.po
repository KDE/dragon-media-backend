#: decoder/decodepipeline.cpp:469
#, kde-format
msgid "Failed to create decoder"
msgstr "יצירת מפענח נכשלה"

#: decoder/decodepipeline.cpp:713
#, kde-format
msgid "Stream error"
msgstr "שגיאת תזרים"

#: decoder/decoder.cpp:199
#, kde-format
msgid "Failed to initialize media input"
msgstr "אתחול קלט המדיה נכשל"

#: decoder/decoder.cpp:203
#, kde-format
msgid "Failed to open media container"
msgstr "פתיחת מכולת מדיה נכשלה"

#: decoder/decoder.cpp:207
#, kde-format
msgid "No supported audio stream found"
msgstr "לא נמצא תזרים שמע נתמך"

#: decoder/decoder.cpp:211
#, kde-format
msgid "Audio codec setup failed"
msgstr "הקמת מפענח שמע נכשלה"

#: decoder/decoder.cpp:215
#, kde-format
msgid "Audio resampler setup failed"
msgstr "הקמת דוגם שמע מחדש נכשלה"

#: decoder/decoder.cpp:219
#, kde-format
msgid "Failed to allocate decoder resources"
msgstr "הקצאת משאבי מפענח נכשלה"

#: decoder/decoder.cpp:238
#, kde-format
msgid "Decoder not initialized"
msgstr "המפענח לא אותחל"

#: decoder/decoder.cpp:528
#, kde-format
msgid "Resampler reinitialization failed after seek"
msgstr "אתחול מחדש של דוגם מחדש נכשל לאחר חתירה"

#: decoder/decoder.cpp:571
#, kde-format
msgid "Read error after %1 attempts: %2"
msgstr "שגיאת קריאה אחרי %1 ניסיונות: %2"

#: player/dragonplayer.cpp:121
#, kde-format
msgid "Failed to open the audio output device."
msgstr "פתיחת התקן פלט השמע נכשלה."

#: player/dragonplayer.cpp:273
#, kde-format
msgid "Fatal error while decoding media"
msgstr "שגיאה מכרעת בפיענוח מדיה"

#: player/dragonplayer.cpp:300
#, kde-format
msgid "Error while decoding media"
msgstr "שגיאה בפיענוח מדיה"

#: player/dragonplayer.cpp:840
#, kde-format
msgid "Failed to open media source"
msgstr "פתיחת מקור מדיה נכשלה"

#: player/dragonplayer.cpp:840
#, kde-format
msgid "Network error"
msgstr "שגיאת רשת"

#: sink/nullaudiosink.cpp:16
#, kde-format
msgid "Could not find any audio sink plugins."
msgstr "לא נמצאו תוספי יעדי שמע כלשהם."

#: sink/pipewireaudiosink.cpp:287
#, kde-format
msgid "PipeWire: connection to the PipeWire server failed"
msgstr "PipeWire: החיבור לשרת ה־PipeWire נכשל"

#: sink/pipewireaudiosink.cpp:292
#, kde-format
msgid "PipeWire: failed to connect stream"
msgstr "PipeWire: החיבור לתזרים נכשל"

#: sink/pulseaudiosink.cpp:199
#, kde-format
msgid "PulseAudio: failed to create mainloop"
msgstr "PulseAudio: יצירת הלולאה הראשית נכשלה"

#: sink/pulseaudiosink.cpp:206
#, kde-format
msgid "PulseAudio: failed to start mainloop"
msgstr "PulseAudio: הפעלת הלולאה הראשית נכשלה"

#: sink/pulseaudiosink.cpp:220
#, kde-format
msgid "PulseAudio: failed to get mainloop API"
msgstr "PulseAudio: משיכת ה־API של הלולאה הראשית"

#: sink/pulseaudiosink.cpp:245
#, kde-format
msgid "PulseAudio: failed to create context"
msgstr "PulseAudio: יצירת ההקשר נכשלה"

#: sink/pulseaudiosink.cpp:255
#, kde-format
msgid "PulseAudio: failed to connect context"
msgstr "PulseAudio: ההתחברות להקשר נכשלה"

#: sink/pulseaudiosink.cpp:267
#, kde-format
msgid "PulseAudio: context not ready"
msgstr "PulseAudio: ההקשר לא מוכן"

#: sink/pulseaudiosink.cpp:335
#, kde-format
msgid "PulseAudio audio device is poisoned"
msgstr "התקן שמע PulseAudio מורעל"

#: sink/pulseaudiosink.cpp:381 sink/pulseaudiosink.cpp:387
#: sink/pulseaudiosink.cpp:391
#, kde-format
msgid "PulseAudio: failed to connect stream"
msgstr "PulseAudio: התחברות לתזרים נכשלה"

#: sink/sdlaudiosink.cpp:159
#, kde-format
msgid "SDL: audio output is in a zombie state after a failed close"
msgstr "SDL: פלט השמע הוא במצב זומבי אחרי סגירה שנכשלה"

#: stream/cd/cddisc.cpp:111
#, kde-format
msgid "The CD has no tracks."
msgstr "אין רצועות בתקליטור."

#: stream/cd/cddisc.cpp:148
#, kde-format
msgid "The disc is not an Audio CD."
msgstr "זה לא תקליטור שמע."

#: stream/cd/cddisc.cpp:189
#, kde-format
msgid "Could not open the CD device. Check that a disc is present."
msgstr "לא ניתן לפתוח את התקן התקליטור. נא לבדוק שיש בתוכו תקליטור."

#: stream/cd/cdstream.cpp:117
#, kde-format
msgid "The audiocd:/ URL does not name a track to play."
msgstr "כתובת ה־audiocd:/‎ לא מציינת רצועה לניגון."

#: stream/cd/cdstream.cpp:155
#, kde-format
msgid "Track not found on the CD: %1"
msgstr "הרצועה לא נמצאה בתקליטור: %1"

#: stream/cd/cdstream.cpp:159
#, kde-format
msgid "CD track %1 is not an audio track."
msgstr "רצועת התקליטור %1 אינה רצועת שמע."

#: stream/cd/cdstream.cpp:166
#, kde-format
msgid "Could not determine the length of CD track %1."
msgstr "לא ניתן לאתר את אורך רצועת התקליטור %1."

#: stream/cd/cdstream.cpp:284
#, kde-format
msgid "The CD is no longer available."
msgstr "התקליטור לא זמין עוד."

#: stream/cd/cdstream.cpp:289
#, kde-format
msgid "Attempted to read past the end of the CD track."
msgstr "התבצע ניסיון לקרוא מעבר לסוף רצועת התקליטור."

#: stream/cd/cdstream.cpp:296
#, kde-format
msgid "Error reading the CD. The disc may have been ejected."
msgstr "שגיאה בקריאת התקליטור. יכול להיות שהוא נשלף החוצה."

#: stream/cd/dragoncdtocreader.cpp:69
#, kde-format
msgid "This build of Dragon Media Backend was made without CD support."
msgstr "המהדורה הזאת של מנגנון המדיה Dragon נבנתה ללא תמיכה בתקליטורים."

#: stream/http/httpprotocol.cpp:227 stream/http/httpsocket.cpp:247
#: stream/http/httpsocket.cpp:340
#, kde-format
msgid "Malformed response"
msgstr "תגובה פגומה"

#: stream/http/httpsocket.cpp:31
#, kde-format
msgid "Stream stopped sending data"
msgstr "התזרים הפסיק לשלוח נתונים"

#: stream/http/httpsocket.cpp:88
#, kde-format
msgid "Invalid stream URL: %1"
msgstr "כתובת תזרים שגויה: %1"

#: stream/http/httpsocket.cpp:104 stream/http/httpsocket.cpp:457
#, kde-format
msgid "Connection closed"
msgstr "החיבור נסגר"

#: stream/http/httpsocket.cpp:366 stream/http/httpsocket.cpp:376
#, kde-format
msgid "Server responded with status %1"
msgstr "השרת הגיב עם הודעת מצב %1"

#: stream/http/httpsocket.cpp:372
#, kde-format
msgid "Proxy requires authentication"
msgstr "המתווך דורש אימות"

#: stream/http/httpsocket.cpp:383
#, kde-format
msgid "Server returned unexpected byte range"
msgstr "השרת החזיר טווח בתים לא צפוי"

#: stream/http/httpsocket.cpp:388
#, kde-format
msgid "Server ignored requested byte range"
msgstr "השרת התעלם מטווח הבתים שהתבקש"

#: stream/http/httpsocket.cpp:399 stream/http/httpsocket.cpp:409
#: stream/http/httpsocket.cpp:413 stream/http/httpsocket.cpp:416
#, kde-format
msgid "Unusable redirect address"
msgstr "כתובת הפניה בלתי שימושית"

#: stream/http/httpsocket.cpp:402
#, kde-format
msgid "Too many redirects"
msgstr "יותר מדי הפניות"

#: stream/http/radiostream.cpp:246
#, kde-format
